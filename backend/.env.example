APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://email_assistant:email_assistant@postgres:5432/email_assistant
JWT_SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_BOOTSTRAP_SECRET=dev-bootstrap-secret
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TEXT_MODEL=gpt-4o-mini
TAVILY_API_KEY=
DEEPGRAM_API_KEY=
MAX_RETRIES_PER_AGENT=2
MAX_TOTAL_RETRIES=5
HARD_TIMEOUT_E2E_SECONDS=30
QUALITY_THRESHOLD=85
TAVILY_MAX_RESULTS=5
EVAL_CORE_DATASET_PATH=src/evaluation/datasets/core_prompts.jsonl
EVAL_TONE_THRESHOLD=85
EVAL_FACTUALITY_THRESHOLD=85
EVAL_CLARITY_THRESHOLD=90
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=email-assistant
LANGSMITH_API_KEY=
RETENTION_DRAFTS_DAYS=90
RETENTION_TRANSCRIPTS_DAYS=30
RETENTION_LOGS_DAYS=90
RETENTION_SCHEDULER_ENABLED=true
RETENTION_SCHEDULER_INTERVAL_MINUTES=60
ALERT_P95_LATENCY_MS_THRESHOLD=12000
ALERT_FALLBACK_RATE_THRESHOLD=0.2
ALERT_PROVIDER_ERROR_RATE_THRESHOLD=0.05
ALERT_SAFETY_FAILURE_RATE_THRESHOLD=0.01
STRICT_PROVIDER_MODE=true
